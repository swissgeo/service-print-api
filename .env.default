# used for local development
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1
# to suppress docker compose warning AWS_KEY not set
AWS_ACCESS_KEY_ID=123
AWS_SECRET_ACCESS_KEY=123
 # boolean TRUE or FALSE
AWS_LOCAL=true
 # port for local AWS services such as dynamodb and sqs
LOCALSTACK_PORT=4566
 # port for make serve or make gunicorn serve
HTTP_PORT=3000

DYNAMODB_TABLE_NAME="service-print-api"
SQS_QUEUE_NAME="service-print-queue"
