# used for local development
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=123
AWS_SECRET_ACCESS_KEY=123
 # boolean TRUE or FALSE
AWS_LOCAL=true
# moto server port and endpoint for local AWS service emulation (DynamoDB, SQS, S3)
# MOTO_PORT is used by docker-compose to expose the container port
MOTO_PORT=5000
MOTO_HOST=localhost
# shared across service-print-api and service-print-renderer so both projects
# share the same moto-server container instead of each spinning up their own
COMPOSE_PROJECT_NAME=service-print-local
 # port for make serve or make gunicorn serve
HTTP_PORT=3000
ROOT_PATH=/api/wps/v1/print
# publish OpenAPI spec + docs (public at /docs, internal at /internal/docs)
PUBLISH_OPENAPI_SPEC=1

DYNAMODB_TABLE_NAME=service-print-jobs-local
SQS_QUEUE_NAME=service-print-jobs-queue-local
SQS_DL_QUEUE_NAME=service-print-jobs-dlq-local
AWS_CONNECT_TIMEOUT=5
AWS_READ_TIMEOUT=30

# SQS queue configuration
# How many times a message can be received before being routed to the DLQ
SQS_MAX_RECEIVE_COUNT=3
# How long (in seconds) a received message is hidden from other consumers before becoming visible again
SQS_VISIBILITY_TIMEOUT=60
# Maximum number of messages allowed in the queue before returning 503 to new print requests
SQS_QUEUE_MAX_LENGTH=100

# S3: only used to build the PDF download URL in local dev; must match the
# renderer's S3_BUCKET_NAME / S3_PDF_PREFIX so the URL points at the uploaded object
S3_BUCKET_NAME=service-print-pdf-local
S3_PDF_PREFIX=api/wps/v1/print/pdf

# Logging
LOGGING_ENABLE_DEV_SERVER_LOGGING=true
LOGGING_CONFIG_FILE=logging-local-config.yaml

# OTEL: disabled by default for local dev (console logging only); set to false to
# exercise the full OTEL pipeline locally (see README: Local OTEL testing).
OTEL_SDK_DISABLED=true
OTEL_ENABLE_FASTAPI=true
OTEL_ENABLE_BOTO=true
OTEL_ENABLE_OTLP_EXPORTER=true
OTEL_ENABLE_METRICS=true
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_METRIC_EXPORT_TIMEOUT=3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_RESOURCE_ATTRIBUTES=service.name=service-print-api
OTEL_PYTHON_EXCLUDED_URLS=/checker
