# used for local development with OTEL console exporters
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=123
AWS_SECRET_ACCESS_KEY=123
AWS_LOCAL=true
MOTO_PORT=5000
MOTO_HOST=localhost
COMPOSE_PROJECT_NAME=service-print-local
HTTP_PORT=3000
API_PATH_PREFIX=/api/wps/v1/print

DYNAMODB_TABLE_NAME=service-print-jobs-local
SQS_QUEUE_NAME=service-print-jobs-queue-local
SQS_DL_QUEUE_NAME=service-print-jobs-dlq-local
AWS_CONNECT_TIMEOUT=5
AWS_READ_TIMEOUT=30

SQS_MAX_RECEIVE_COUNT=3
SQS_VISIBILITY_TIMEOUT=60
SQS_QUEUE_MAX_LENGTH=100

S3_BUCKET_NAME=service-print-pdf-local

# Logging — uvicorn loads the config via --log-config (see Makefile dockerrun)
LOGGING_ENABLE_DEV_SERVER_LOGGING=false
LOGGING_CONFIG_FILE=logging-otel-config.yaml

# OTEL — console exporters only, no OTLP collector required
OTEL_SDK_DISABLED=false
OTEL_ENABLE_FASTAPI=true
OTEL_ENABLE_BOTO=true
OTEL_ENABLE_OTLP_EXPORTER=false
OTEL_ENABLE_METRICS=true
OTEL_METRICS_EXPORTERS=console
OTEL_LOGGING_EXPORTERS=console
OTEL_RESOURCE_ATTRIBUTES=service.name=service-print-api
OTEL_PYTHON_EXCLUDED_URLS="checker"
